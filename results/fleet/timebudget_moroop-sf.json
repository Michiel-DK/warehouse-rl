 "deviations": [
  {
   "deviation": "pooled = sum of the nine per-shift timebudget runs (seconds, jobs, spans summed; shares and jobs_per_robot_hour recomputed from the sums)",
   "item": "pooled numbers",
   "reason": "serial moroop-amr-1 has no Z<zone>- prefix, so every shift is zone ''; one timebudget run over all nine files would have read_messages drop shifts 2-9 as duplicate (serial, headerId) and merge them into one robot"
  },
  {
   "deviation": "reported (disjoint true/false per id pair), not asserted",
   "item": "station cells distinct",
   "reason": "the brief says report, do not fail; docs/LITERATURE.md Part 2b section 4 said assert"
  },
  {
   "deviation": "a stuck run is the half-open [start ts, ts owning-end of its last message); the hit window [label start, label end + 30 s] and the false-alarm window [run start - 30, run end + 30] are closed at the far end; label episodes are half-open [floor(first ts), floor(next None ts))",
   "item": "label window overlap",
   "reason": "the brief gives intervals without endpoint conventions"
  },
  {
   "deviation": "an episode with no later 'None' row ends at the last emitted message's timestamp",
   "item": "label episode at stream end",
   "reason": "'stream end' in the brief; the bucket grid ends there"
  },
  {
   "deviation": "seconds = the interval each kept message owns (next kept ts - ts), no_data intervals included",
   "item": "seconds per state value",
   "reason": "the brief asks rows and seconds per state / operating_mode value without a gap rule"
  },
  {
   "deviation": "removed rows = max(id) - min(id) + 1 - rows, not max(id) - rows",
   "item": "removed rows",
   "reason": "ids continue across shifts (a shift's ids do not start at 1), so max(id) - rows would add the earlier shifts' rows; for shift 0 (ids from 1) the two agree"
  },
  {
   "deviation": "nearest rank: sorted[ceil(p * n) - 1]",
   "item": "percentiles",
   "reason": "deterministic and dependency free"
  },
  {
   "deviation": "the bucket of an owned interval is taken from timebudget.robot_budget called on the pair (message i, message i+1); stuck vs stopped_short for the 'anywhere else' case is then decided with timebudget.stopped_runs / run_is_stuck on the full stream",
   "item": "per-second bucket assignment",
   "reason": "reuse the precedence instead of rewriting it; the per-bucket second counts are asserted equal to the timebudget output"
  },
  {
   "deviation": "a diagnostics status at level Error that is not on the noise list is an errors entry (FATAL), so parse.faulted is true; the faulted time-budget bucket is computed",
   "item": "faults: errors and faulted",
   "reason": "docs/LITERATURE.md Part 9 section 1 (ours, rank B); REP 107 says a component ERROR does not by itself halt the system, so the faulted bucket is a count of reported errors, not of stopped seconds"
  }
 ],
