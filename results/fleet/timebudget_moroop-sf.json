 "mapping": [
  {
   "field": "timestamp",
   "rule": "floor to whole seconds, UTC, '%Y-%m-%dT%H:%M:%SZ'; keep the LAST native row of each second",
   "source_columns": [
    "created_at"
   ]
  },
  {
   "field": "headerId",
   "rule": "1..n contiguous over this shift's emitted messages; never the dataset id (gaps in id are screening removals)",
   "source_columns": [
    "id"
   ]
  },
  {
   "field": "manufacturer",
   "rule": "constant 'wheel.me'",
   "source_columns": []
  },
  {
   "field": "serialNumber",
   "rule": "constant 'moroop-amr-1' (no Z<zone>- prefix, so parse.zone_of gives zone '')",
   "source_columns": []
  },
  {
   "field": "orderId",
   "rule": "job_id of the operation running at the kept row's native created_at (start_time <= t < finish_time; null start or finish never runs); none running but the last finished operation before t and the next starting one after t share a job -> that job; two running -> latest start_time wins, second counted in overlap_seconds; job_type 'charging' -> ''",
   "source_columns": [
    "operations.job_id",
    "operations.start_time",
    "operations.finish_time",
    "jobs.payload.job_type"
   ]
  },
  {
   "field": "agvPosition.x",
   "rule": "math.floor(pos_x / cell_m), cell_m 0.5 (floor, not int())",
   "source_columns": [
    "pos_x"
   ]
  },
  {
   "field": "agvPosition.y",
   "rule": "math.floor(pos_y / cell_m), cell_m 0.5 (floor, not int())",
   "source_columns": [
    "pos_y"
   ]
  },
  {
   "field": "agvPosition.theta",
   "rule": "pos_theta as float (radians)",
   "source_columns": [
    "pos_theta"
   ]
  },
  {
   "field": "driving",
   "rule": "hypot(velocity_x, velocity_y) > 0.05 m/s OR abs(velocity_omega) > 0.05 rad/s (strict); never state == 'Navigating'",
   "source_columns": [
    "velocity_x",
    "velocity_y",
    "velocity_omega"
   ]
  },
  {
   "field": "paused",
   "rule": "state == 'Paused' or operating_mode != 'Autonomous'",
   "source_columns": [
    "state",
    "operating_mode"
   ]
  },
  {
   "field": "errors",
   "rule": "one entry per diagnostics status of the kept row at level exactly 'Error' whose (name, message, level) is not on the noise list, in status order: {errorType: name, errorLevel: 'FATAL', errorDescription: message[:120]}; Ok, Warning, Stale and noise never enter; unparseable diagnostics -> [] and counted; stuck_reason, TIMEOUT and operation_start_denied are never errors",
   "source_columns": [
    "diagnostics"
   ]
  },
  {
   "field": "loads",
   "rule": "[] (no payload column in the robot state)",
   "source_columns": []
  },
  {
   "field": "waiting_shelf",
   "rule": "'n/a': no shelves, no picker",
   "source_columns": []
  },
  {
   "field": "faulted",
   "rule": "parse.py: some errors entry with errorLevel FATAL, i.e. the kept row has a qualifying Error status. Our rule, rank B (REP 107: a component ERROR does not halt the system). Public label 'Robot reported a component error', never 'Robot error, cannot continue order'",
   "source_columns": [
    "diagnostics"
   ]
  },
  {
   "field": "stations",
   "rule": "per current_position_id in 135 charging / 136 warehouse / 137 kitting / 138 assembly, every cell (same grid) holding >= 5 % of the state == 'Idle' cleaned rows at that id, pooled over nine shifts; shelves []",
   "source_columns": [
    "state",
    "current_position_id",
    "pos_x",
    "pos_y"
   ]
  }
 ],
